{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Token Saver Runtime Version",
  "type": "object",
  "required": [
    "setup_version",
    "runtime_schema_version"
  ],
  "properties": {
    "setup_version": {
      "type": "string"
    },
    "runtime_schema_version": {
      "type": "string"
    },
    "initialized_at": {
      "type": "string"
    },
    "last_upgraded_at": {
      "type": "string"
    },
    "upgrade_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}