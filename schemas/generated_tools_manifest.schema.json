{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Token Saver Generated Tools Manifest",
  "type": "object",
  "required": [
    "version",
    "tools"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "repository_name": {
      "type": "string"
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": true
}