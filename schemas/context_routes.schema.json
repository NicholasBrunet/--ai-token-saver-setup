{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Token Saver Context Routes",
  "type": "object",
  "required": [
    "version",
    "routes"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "repository_name": {
      "type": "string"
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "route_name",
          "description",
          "match_terms",
          "task_terms",
          "recommended_scope",
          "include_paths",
          "avoid_paths"
        ],
        "properties": {
          "route_name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "match_terms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "negative_match_terms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "task_terms": {
            "type": "string"
          },
          "recommended_scope": {
            "type": "string"
          },
          "include_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "avoid_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "related_systems": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "validation_commands": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "known_pitfalls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}